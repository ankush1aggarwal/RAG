# Copy to `.env` and fill in secrets. See README and PROJECT_SPEC.

# COHERE_API_KEY=

# Optional overrides (defaults in src/app/config/settings.py)
# EMBEDDING_METHOD=sentence_transformer
# EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral:latest
# FIQA_CORPUS_LIMIT=0
# CHUNK_SIZE=200
# CHUNK_OVERLAP_FRACTION=0.2
# QDRANT_PATH=data/qdrant_local
# COLLECTION_NAME=fiqa_cs200_bge_base_en_v1_5
# RETRIEVAL_TOP_K=10
# API_ENFORCE_FROZEN_RETRIEVAL=true
# RERANKER_PROVIDER=none
# RERANK_CANDIDATE_LIMIT=50
