# Copy to `.env` and fill in secrets. See README and PROJECT_SPEC.

# --- Local development (default) ---
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral:latest
# QDRANT_PATH=data/qdrant_local
# BM25_INDEX_DIR=data/bm25_indexes
#
# Local vs cloud vectors: unset QDRANT_URL → use QDRANT_PATH (data/qdrant_local/...).
# Set QDRANT_URL + QDRANT_API_KEY → remote Qdrant Cloud (QDRANT_PATH ignored).
# Migrate local → cloud: re-run ingest with URL set — docs/cloud_run.md#migrate-local-collection--qdrant-cloud
# GCP first deploy history: docs/cloud_run_deployment.md
# Public demo + manual Cloud Run release after merge to main: docs/public_demo_operations_runbook.md

# --- Cloud Run production (set in Secret Manager / service env, not committed) ---
# QDRANT_URL=https://<cluster>.cloud.qdrant.io:6333
# QDRANT_API_KEY=
# LLM_PROVIDER=cohere
# COHERE_API_KEY=
# COHERE_CHAT_MODEL=command-r-08-2024
# BM25_INDEX_DIR=deploy/index_metadata
# (manifest baked in image under deploy/index_metadata/)

# COHERE_API_KEY=

# Optional overrides (defaults in src/app/config/settings.py)
# EMBEDDING_METHOD=sentence_transformer
# EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# FIQA_CORPUS_LIMIT=0
# CHUNK_SIZE=200
# CHUNK_OVERLAP_FRACTION=0.2
# COLLECTION_NAME=fiqa_cs200_bge_base_en_v1_5
# RETRIEVAL_TOP_K=10
# API_ENFORCE_FROZEN_RETRIEVAL=true
# QUERY_TIMEOUT_SECONDS=120
# LOG_LEVEL=INFO
# STRUCTURED_LOGGING_ENABLED=true
# LOG_MAX_FIELD_CHARS=120
# COHERE_CHAT_INPUT_USD_PER_1M=
# COHERE_CHAT_OUTPUT_USD_PER_1M=
# RERANKER_PROVIDER=none
# RERANK_CANDIDATE_LIMIT=50

# Docker (see docs/docker.md): CI builds/smokes on GitHub Actions, pushes GHCR on main; Cloud Run deploy is manual (docs/public_demo_operations_runbook.md)
